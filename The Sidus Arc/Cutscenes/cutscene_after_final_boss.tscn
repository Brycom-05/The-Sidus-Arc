[sub_resource type="Resource" id="Resource_dwuy7"]
script = ExtResource("2_0qvkx")
text = "You’ve defeated me… but at what cost…"
show_right = true

[sub_resource type="Resource" id="Resource_uys4h"]
script = ExtResource("2_0qvkx")
text = " I was never going to use the Sidus Arc to destroy the world… I wanted to SAVE it…"
show_right = true

[sub_resource type="Resource" id="Resource_gy4b1"]
script = ExtResource("2_0qvkx")
text = "The brutal aristocracy that has reigned us all for years… I wanted it to end!"
show_right = true

[sub_resource type="Resource" id="Resource_y6lnt"]
script = ExtResource("2_0qvkx")
text = "You were lied to, “player”… You were contracted by a member of the aristocracy itself… to stop me."
show_right = true

[sub_resource type="Resource" id="Resource_4t2r7"]
script = ExtResource("2_0qvkx")
text = "... that is true. I am a member of the aristocracy, and that is why I know that we are not all evil, Vael."
show_left = true

[sub_resource type="Resource" id="Resource_emiqa"]
script = ExtResource("2_0qvkx")
text = "That doesn’t matter… we’ve lost now… we failed."
show_right = true

[sub_resource type="Resource" id="Resource_el55c"]
script = ExtResource("2_0qvkx")
text = "And the aristocracy lives on!"
show_left = true

